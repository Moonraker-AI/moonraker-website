---
import '../styles/globals.css';
// Content-hashed by Vite. This MUST stay an import rather than a literal
// /assets/site.js path: the worker's edge cache key is origin + pathname and
// drops the query string, so a ?v= parameter cannot bust a cached asset.
// Only a changed path can, and this gives us one automatically.
import siteJsUrl from '../scripts/site.js?url';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  /**
   * Landing-page mode. Drops the site nav and the footer link list, leaving a
   * logo and a legal-minimum footer. Paid landing pages should set this: the
   * full chrome adds 25 outbound links to a page whose only job is one
   * conversion, and every one of them is a way for a click we paid for to
   * wander off. Organic pages keep the chrome, which is what they want.
   */
  bare?: boolean;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = 'https://moonraker.ai/assets/og-image.jpg',
  ogUrl,
  bare = false,
} = Astro.props;

const ogTitleResolved = ogTitle ?? title;
const ogDescriptionResolved = ogDescription ?? description;

// Active nav state, computed from the route (the old static pages hard-coded it).
const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isCore = path === '/core-marketing-system' || path.startsWith('/core-marketing-system/');
const isWork = path === '/services' || path === '/process' || path === '/scope';
// Google tag ids. 'PENDING' disables the tag entirely (no script emitted), so
// this ships safely before the Ads sub-account exists. Swap in the real ids
// (G-XXXX, AW-XXXX, AW-XXXX/label) and republish to go live.
const GA4_ID = 'G-L8T7ZPXTD5';
const AW_ID = 'AW-18338412822';
const AW_CONV = 'AW-18338412822/g7y6CNbl0dMcEJbyt6hE';
const ADS_ENABLED = GA4_ID.startsWith('G-') && AW_ID.startsWith('AW-');
// OpenAI Ads (ChatGPT) Measurement Pixel. Same enable-by-id-shape pattern as
// the Google tag: 'PENDING' emits nothing. The pixel_id comes from the
// conversion source on ad account adacct_6a63d570 (Moonraker.AI, LLC).
// The SDK origin (bzrcdn.openai.com) and the collector (bzr.openai.com) must
// both stay in the worker CSP or the pixel fails silently.
const OAI_PIXEL_ID = 'RuDz8A9fNw4SFZMWCp8UFh';
const OAI_ENABLED = OAI_PIXEL_ID !== 'PENDING';
const OAI_JS =
  "(function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;" +
  "var js=d.createElement(s);js.async=true;js.src=u;var f=d.getElementsByTagName(s)[0];" +
  "f.parentNode.insertBefore(js,f)})(window,document,'script','https://bzrcdn.openai.com/sdk/oaiq.min.js');" +
  "oaiq('init',{pixelId:'" + OAI_PIXEL_ID + "'});";
// The Google tag is DEFERRED to idle or first interaction, whichever comes
// first (oi-228). It was 321 KB of the critical path: one gtag.js install that
// then fetches a destination config per configured id (AW ~143 KB, GA4 ~178 KB).
// PSI reported ~134 KB of it unused and scores swung 66-95 run to run on stable
// FCP, which is CPU contention from these scripts on a throttled mobile run.
//
// What makes deferring safe rather than lossy:
//   - The gtag STUB and both configs are pushed to dataLayer immediately, at
//     zero network cost. gtag.js replays that queue on load, so page_view and
//     any event fired before the library arrives still send. This is the
//     documented pattern, not a trick.
//   - Attribution never depended on the tag: ATTRIB_JS above captures gclid /
//     gbraid / wbraid / msclkid and the utm set into sessionStorage on landing,
//     before any third-party script runs.
//   - The idle path fires within a couple of seconds of paint, so a bounce with
//     zero interaction is still counted. Interaction-only gating would have
//     dropped those; this deliberately does not.
//   - mrTrackConversion force-loads the library (see CONV_JS), so a conversion
//     never waits on idle.
const GTAG_JS =
  "window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}" +
  "gtag('js',new Date());gtag('config','" + GA4_ID + "');gtag('config','" + AW_ID + "');" +
  // Idempotent loader. Returns the same promise on every call, so the idle
  // path, an interaction and a conversion can all ask for it and only one
  // request is made. Resolves false on network error rather than rejecting:
  // no caller should have to wrap this in a try/catch to avoid an unhandled
  // rejection, and a blocked tag must never break a booking.
  "window.mrLoadGtag=(function(){var p=null;return function(){if(p)return p;" +
  "p=new Promise(function(res){var s=document.createElement('script');s.async=true;" +
  "s.src='https://www.googletagmanager.com/gtag/js?id=" + AW_ID + "';" +
  "s.onload=function(){res(true)};s.onerror=function(){res(false)};" +
  "document.head.appendChild(s)});return p}})();" +
  "(function(){var done=false;function go(){if(done)return;done=true;window.mrLoadGtag()}" +
  // Interaction wins immediately at any point: someone who taps at 200ms is
  // engaged, and their session should be measured from the start.
  "['pointerdown','keydown','touchstart','scroll','mousemove'].forEach(function(e){" +
  "window.addEventListener(e,go,{passive:true,once:true})});" +
  // The idle path waits for LOAD first. requestIdleCallback alone was not
  // enough: measured locally it fired at 393ms, before first paint at 424ms,
  // so the tag was still racing the critical path it was supposed to leave.
  // After load, idle with a timeout so a busy main thread cannot postpone it
  // indefinitely; setTimeout is the Safari fallback.
  "function sched(){if('requestIdleCallback' in window)requestIdleCallback(go,{timeout:3500});" +
  "else setTimeout(go,2500)}" +
  "if(document.readyState==='complete')sched();" +
  "else window.addEventListener('load',sched,{once:true})})();";
// Lead-source capture. FIRST TOUCH within the session: written once, so a
// visitor who lands on an ad and books three pages later still carries the ad
// params. Stored even when no tags are present, because the referrer and
// landing page are themselves the evidence for organic vs direct, and an
// empty record is what proves capture ran rather than failed.
//
// This is deliberately OUTSIDE GTAG_JS: attribution matters whether or not
// either ad platform is enabled, and it used to be trapped inside the Google
// tag where it was written and never read by anything.
//
// Click ids beyond gclid are captured because Google drops gbraid/wbraid
// instead of gclid on iOS app and privacy-restricted traffic, and those
// bookings would otherwise read as direct.
// Storage is localStorage with a 90-day expiry, NOT sessionStorage.
// sessionStorage dies with the tab, so anyone who clicked an ad on Monday
// and booked on Thursday was recorded as direct. 90 days matches Google's
// own click lookback, so our number and theirs describe the same window.
// sessionStorage is still written as a fallback for Safari private mode,
// where localStorage throws.
//
// Overwrite rule: first touch WINS, except that a visit carrying a paid
// click id always overwrites. Pure first-touch would credit an ad click to
// an organic visit from two months earlier and hide the paid channel from
// the only report we use to decide spend.
const ATTRIB_JS =
  "(function(){var K='mr_attrib',TTL=7776000000;" +
  "function rd(){var s=null;try{s=localStorage.getItem(K);}catch(e){}" +
  "if(!s){try{s=sessionStorage.getItem(K);}catch(e){}}" +
  "if(!s)return null;try{return JSON.parse(s);}catch(e){return null;}}" +
  "function wr(o){var s=JSON.stringify(o);" +
  "try{localStorage.setItem(K,s);}catch(e){}try{sessionStorage.setItem(K,s);}catch(e){}}" +
  "var PAID=['gclid','gbraid','wbraid','msclkid','fbclid'];" +
  // Unwrap both shapes: the current {a,exp} envelope and the bare object
  // written by the sessionStorage-only version, which is still sitting in
  // returning visitors' browsers.
  "window.mrAttribRecord=function(){var r=rd();if(!r)return null;" +
  "if(r.a){return(r.exp&&r.exp<Date.now())?null:r.a;}return r;};" +
  "try{var p=new URLSearchParams(location.search),a={};" +
  "['utm_source','utm_medium','utm_campaign','utm_term','utm_content'," +
  "'gclid','gbraid','wbraid','oppref','msclkid','fbclid']" +
  ".forEach(function(k){var v=p.get(k);if(v)a[k]=String(v).slice(0,200);});" +
  "a.landing_page=(location.origin+location.pathname).slice(0,500);" +
  "if(document.referrer)a.referrer=String(document.referrer).slice(0,500);" +
  "a.captured_at=new Date().toISOString();" +
  "var paid=PAID.some(function(k){return !!a[k];});" +
  "if(paid||!window.mrAttribRecord())wr({a:a,exp:Date.now()+TTL});}catch(e){}})();" +
  // Read helper so every intake form forwards the same object without
  // each page reimplementing the parse-and-guard dance. Returns the flat
  // record the booking API expects, never the storage envelope.
  "window.mrAttribution=function(){try{return window.mrAttribRecord();}catch(e){return null;}};";
// Single booked-call conversion hook, fired by the booking forms. Defined
// outside GTAG_JS so it exists whenever either ad platform is enabled, and
// each platform is guarded independently: a missing gtag must not stop the
// OpenAI event. txnId (the booking id) doubles as the OpenAI event_id, which
// is what deduplicates this against the server-side Conversions API event.
const CONV_JS =
  "window.mrTrackConversion=function(txnId){" +
  // Force the deferred library up before firing. The events below are queued
  // on dataLayer either way and replay on load, so they are not lost while it
  // arrives; this just stops a conversion from waiting on the idle callback.
  "try{if(typeof window.mrLoadGtag==='function')window.mrLoadGtag();}catch(e){}" +
  "try{if(typeof gtag==='function'){" +
  "gtag('event','conversion',{send_to:'" + AW_CONV + "',transaction_id:txnId||''});" +
  "gtag('event','book_strategy_call');}}catch(e){}" +
  "try{if(typeof oaiq==='function'){" +
  "oaiq('measure','appointment_scheduled',{type:'customer_action'}," +
  "txnId?{event_id:String(txnId)}:{});}}catch(e){}};";
// Self-hosted @font-face, inlined into the head so no stylesheet request
// stands between the browser and styled text. Latin subset only, which is
// what the Google Fonts css2 URL was serving us anyway. Weights are the ones
// the site actually uses: Outfit 400/600/700/800 (800 carries the headings,
// 100 uses) and Inter 400/500/600 for body.
const FONT_WEIGHTS = [
  ['Outfit', 400, 'outfit-latin-400-normal'],
  ['Outfit', 600, 'outfit-latin-600-normal'],
  ['Outfit', 700, 'outfit-latin-700-normal'],
  ['Outfit', 800, 'outfit-latin-800-normal'],
  ['Inter', 400, 'inter-latin-400-normal'],
  ['Inter', 500, 'inter-latin-500-normal'],
  ['Inter', 600, 'inter-latin-600-normal']
];
const FONT_FACE_CSS = FONT_WEIGHTS.map(function (f) {
  return "@font-face{font-family:'" + f[0] + "';font-style:normal;font-weight:" + f[1] +
    ";font-display:swap;src:url('/assets/fonts/" + f[2] + ".woff2') format('woff2');" +
    "unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC," +
    "U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}";
}).join('');
const PREPAINT =
  "(function(){var d=document.documentElement;d.classList.add('js');var t=localStorage.getItem('moonraker-theme');if(t==='dark')d.classList.add('dark');try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('js-reveal')}catch(e){}})();";
const THEME_JS =
  "window.toggleTheme=function(){function apply(){var dark=document.documentElement.classList.toggle('dark');localStorage.setItem('moonraker-theme',dark?'dark':'light');var b=document.getElementById('themeBtn');if(b)b.innerHTML=dark?'&#9728;&#65039;':'&#127769;'}if(document.startViewTransition)document.startViewTransition(apply);else apply()};(function(){var b=document.getElementById('themeBtn');if(b)b.innerHTML=document.documentElement.classList.contains('dark')?'&#9728;&#65039;':'&#127769;'})();";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<meta property="og:title" content={ogTitleResolved}>
{ogDescriptionResolved && <meta property="og:description" content={ogDescriptionResolved}>}
<meta property="og:type" content="website">
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
{ogUrl && <meta property="og:url" content={ogUrl}>}
{canonical && <link rel="canonical" href={canonical}>}
<link rel="icon" href="/assets/favicon-96.png" type="image/png" sizes="96x96">
{/* Fonts are SELF-HOSTED. They used to come from fonts.googleapis.com as a
    render-blocking third-party stylesheet, which put DNS + TLS + a CSS
    round trip + the font files themselves in front of the largest text on
    the page. Measured 2026-07-30 on both paid landing pages: 71 mobile,
    LCP 6.1s, with lcp-breakdown attributing 2436ms of it to element
    render delay and lcp-discovery reporting not-applicable, i.e. the LCP
    element is TEXT waiting on a webfont. The client sites we build already
    self-host their fonts and score 96 to 97, so our own marketing site was
    the slowest thing we ship.

    The @font-face rules are INLINE (below) rather than a stylesheet, so
    there is no extra request before text can be styled, and the two faces
    the largest text actually uses are preloaded. font-display: swap keeps
    text visible immediately in the fallback and swaps when the file lands,
    which arrives fast now that it is first-party on an open connection. */}
<link rel="preload" href="/assets/fonts/outfit-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline set:html={FONT_FACE_CSS}></style>
<script is:inline set:html={PREPAINT}></script>
<script is:inline set:html={ATTRIB_JS}></script>
{/* No eager gtag.js tag here on purpose: GTAG_JS queues the configs and loads
    the library on idle or first interaction. See the GTAG_JS comment. */}
{ADS_ENABLED && <script is:inline set:html={GTAG_JS}></script>}
{ADS_ENABLED && <link rel="preconnect" href="https://www.googletagmanager.com">}
{OAI_ENABLED && <script is:inline set:html={OAI_JS}></script>}
{(ADS_ENABLED || OAI_ENABLED) && <script is:inline set:html={CONV_JS}></script>}
<slot name="head" />
<script is:inline src={siteJsUrl} defer></script>
</head>
<body>
{bare && (
  <nav class="site-nav lp-nav">
    <div class="nav-inner">
      {/* Paid landing pages open their few exits in a new tab: a visitor who
          taps the logo or a legal link should still have the page they landed
          on when they come back. rel guards against reverse tabnabbing. */}
      <a href="/" class="nav-brand" aria-label="Moonraker home (opens in a new tab)" target="_blank" rel="noopener"><img src="/assets/logo-w64.avif" alt="Moonraker" width="32" height="32"></a>
      <div class="nav-right">
        <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark mode" id="themeBtn">&#127769;</button>
      </div>
    </div>
  </nav>
)}
{!bare && (
<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Moonraker home"><img src="/assets/logo-w64.avif" alt="Moonraker" width="32" height="32"></a>
    <ul class="nav-links" id="navLinks">
      <li class="nav-dropdown">
        <a tabindex="0" role="button" aria-haspopup="true" class:list={[isCore && 'active']}>CORE System</a>
        <div class="dropdown-menu">
          <a href="/core-marketing-system" class:list={[path === '/core-marketing-system' && 'active']}>Overview</a>
          <a href="/core-marketing-system/credibility" class:list={[path === '/core-marketing-system/credibility' && 'active']}>Credibility</a>
          <a href="/core-marketing-system/optimization" class:list={[path === '/core-marketing-system/optimization' && 'active']}>Optimization</a>
          <a href="/core-marketing-system/reputation" class:list={[path === '/core-marketing-system/reputation' && 'active']}>Reputation</a>
          <a href="/core-marketing-system/engagement" class:list={[path === '/core-marketing-system/engagement' && 'active']}>Engagement</a>
        </div>
      </li>
      <li class="nav-dropdown">
        <a href="/process" class:list={[isWork && 'active']}>How We Work</a>
        <div class="dropdown-menu">
          <a href="/services" class:list={[path === '/services' && 'active']}>Services</a>
          <a href="/process" class:list={[path === '/process' && 'active']}>Process</a>
          <a href="/scope" class:list={[path === '/scope' && 'active']}>Scope</a>
        </div>
      </li>
      <li><a href="/results" class:list={[path === '/results' && 'active']}>Results</a></li><li><a href="/team" class:list={[path === '/team' && 'active']}>Our Team</a></li>
      <li><a href="/knowledge-hub" class:list={[path === '/knowledge-hub' && 'active']}>Knowledge Hub</a></li>
      <li><a href="/blog" class:list={[(path === '/blog' || path.startsWith('/blog/')) && 'active']}>Blog</a></li>
    </ul>
    <div class="nav-right">
      <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark mode" id="themeBtn">&#127769;</button>
      <a href="/free-strategy-call" class="nav-cta">Free Strategy Call</a>
      <button type="button" class="nav-toggle" onclick="document.getElementById('navLinks').classList.toggle('open')" aria-label="Menu">&#9776;</button>
    </div>
  </div>
</nav>
)}
<slot />
{bare ? (
  <footer class="site-footer">
    <div class="footer-links"><a href="/privacy" target="_blank" rel="noopener">Privacy</a><a href="/terms" target="_blank" rel="noopener">Terms</a></div>
    <div class="footer-copy">&#169; 2026 Moonraker AI. All rights reserved.</div>
  </footer>
) : (
<footer class="site-footer">
  <div class="footer-links"><a href="/">Home</a><a href="/services">Services</a><a href="/core-marketing-system">CORE System</a><a href="/results">Results</a><a href="/team">Our Team</a><a href="/knowledge-hub">Knowledge Hub</a><a href="/blog">Blog</a><a href="/process">Process</a><a href="/scope">Scope</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
  <div class="footer-copy">&#169; 2026 Moonraker AI. All rights reserved.</div>
</footer>
)}
<script is:inline set:html={THEME_JS}></script>
</body>
</html>
