---
/**
 * BookingWidget: the live strategy-call booking flow (pick a day, pick a
 * time, fill the form, confirm), talking to clients.moonraker.ai.
 *
 * Extracted from free-strategy-call.astro so the paid landing page can host
 * the same flow inline instead of sending traffic to a second page. Two
 * copies of ~400 lines of booking logic would have drifted, and a drift in
 * THIS component silently costs bookings.
 *
 * Constraints worth knowing before editing:
 *  - The script is `is:inline` and defines globals (goToStep, selectDate,
 *    submitBooking) that inline onclick handlers in the markup call. It is
 *    therefore safe to render this component ONCE per page, not twice.
 *  - Styles are `is:global` on purpose. Astro's scoped styles stamp a
 *    data-astro-cid attribute at BUILD time, but this widget creates its
 *    date pills, time pills and states at RUNTIME, so scoped rules would
 *    never match them. That is why the original file already had
 *    on exactly those selectors.
 *  - `lean` drops the practice-address block (country, street, city,
 *    region, postal) plus practice name and the GBP question. Every field
 *    is therefore OPTIONAL to the script: read values through val() and
 *    guard element lookups, because on a lean page those ids do not
 *    exist. A bare getElementById().value here is a TypeError that kills
 *    the whole booking.
 */
// ?url keeps this OUT of the render-blocking page CSS bundle and gets a
// content-hashed filename, which is the only cache-bust that works here.
import bookingCssUrl from '../styles/booking-widget.css?url';

// lean: the short intake used on paid landing pages. Cold ad traffic will
// not fill in a street address to book a free call, and the full form was
// 10 required fields across a 3-step flow. What we lose is audit prep
// richness (city/state feed the local audit), which ops can fill in after
// the call; what we gain is the booking existing at all.
//
// mode: which booking flow this instance runs (oi-038 fold, 2026-08-03).
//  - 'audit' (default): the original flow, POST /api/booking/create-with-audit,
//    full or lean intake. free-strategy-call and the lp pages use this.
//  - 'quick': the 4-field flow from book-a-call.astro, POST
//    /api/booking/quick-book, supports ?email= prefill.
//  - 'reschedule': the token flow from reschedule.astro, POST
//    /api/booking/reschedule with booking_id + token read from ?b= and ?t=,
//    no intake form, shows a link-invalid state on 401/403.
const { defer = false, lean = false, mode = 'audit' } = Astro.props;
const submitLabel = mode === 'reschedule' ? 'Confirm new time'
  : mode === 'quick' ? 'Book the call'
  : 'Confirm booking';
---
<div id="bookingWorkspace" class="booking-workspace" data-defer={defer ? '1' : '0'} data-mode={mode}>
  <div class="tz-banner">
    <span class="tz-banner-icon">&#127758;</span>
    <div>
      <div><strong>You will be meeting with Scott, based in Western Australia (AWST).</strong> He takes new client calls Tuesday through Thursday mornings, 7:30 AM to 12 PM his local time. Pick whatever shows up in your own zone below.</div>
      <div class="tz-banner-line tz-zone-line">All times below are shown in your local zone (<span id="tzLabel">detecting...</span>).</div>
      <div class="tz-banner-line">Wrong zone? <select id="tzPicker" aria-label="Time zone"></select></div>
    </div>
  </div>
  {mode === 'reschedule' && <div class="current-banner" id="currentBanner" hidden>
    <span class="current-banner-icon">&#128197;</span>
    <div>
      <div><strong>Currently scheduled for</strong> <span id="currentWhen"></span></div>
      <div class="current-help">Picking a new time below replaces this booking.</div>
    </div>
  </div>}
  <div id="bookingNotice" class="booking-notice is-hidden" role="alert"></div>
  <div class="booking-card">

    {mode === 'reschedule' && <div class="booking-step" id="stepError" hidden>
      <h2>This reschedule link is no longer valid.</h2>
      <p class="helper">Reschedule links expire 14 days after they're sent, and each booking can only be rescheduled once. Please email <a href="mailto:scott@moonraker.ai">scott@moonraker.ai</a> if you need help moving your call.</p>
    </div>}

    <!-- Step 1: pick date -->
    <div class="booking-step" id="step1" data-active="true">
      <h2>{mode === 'reschedule' ? 'Pick a new day' : 'Pick a day'}</h2>
      <p class="helper">Available days are when Scott has open time over the next three weeks.</p>
      <div id="dateStrip" class="date-strip">
        <div class="loading-state">Loading availability...</div>
      </div>
    </div>

    <!-- Step 2: pick time -->
    <div class="booking-step" id="step2" hidden>
      <button type="button" class="step-back" onclick="goToStep(1)">Back to dates</button>
      <h2 id="step2Title">Pick a time</h2>
      <p class="helper" id="step2Helper">{mode === 'reschedule' ? "Same call length and same host. We'll just move the time." : 'Each call is 30 minutes. We will email you a confirmation with the Zoom link.'}</p>
      <div id="timeGrid" class="time-grid"></div>
    </div>

    <!-- Step 3: form (audit/quick) or confirm (reschedule) -->
    <div class="booking-step" id="step3" hidden>
      <button type="button" class="step-back" onclick="goToStep(2)">Back to times</button>
      <h2>{mode === 'reschedule' ? 'Confirm your new time' : 'A few details'}</h2>
      <p class="helper">{mode === 'reschedule'
        ? "We'll move the calendar invite and email you a fresh confirmation."
        : mode === 'quick'
          ? 'Just a few details so we can send the calendar invite.'
          : 'Helps Scott prepare so the call can focus on what is working, what is missing, and whether Moonraker is a fit.'}</p>

      <div class="summary-box">
        <div class="summary-when" id="summaryWhen"></div>
        <div class="summary-sub" id="summarySub"></div>
      </div>

      {mode !== 'reschedule' && <div class="form-grid">
        <div class="form-row">
          <label for="firstName">First name <span class="req">*</span></label>
          <input id="firstName" type="text" autocomplete="given-name" required>
          <div class="err">Please enter your first name.</div>
        </div>
        <div class="form-row">
          <label for="lastName">Last name <span class="req">*</span></label>
          <input id="lastName" type="text" autocomplete="family-name" required>
          <div class="err">Please enter your last name.</div>
        </div>
        <div class="form-row">
          <label for="email">Email <span class="req">*</span></label>
          <input id="email" type="email" autocomplete="email" required>
          <div class="err">Please enter a valid email address.</div>
        </div>
        {mode === 'audit' && <div class="form-row">
          <label for="phone">Phone <span class="req">*</span></label>
          <input id="phone" type="tel" autocomplete="tel" required>
          <div class="err">Please enter a phone number.</div>
        </div>}
        {(mode === 'quick' || !lean) && <div class="form-row">
          <label for="practiceName">{mode === 'quick' ? 'Practice or company name' : 'Practice name'} <span class="req">*</span></label>
          <input id="practiceName" type="text" autocomplete="organization" required>
          <div class="err">{mode === 'quick' ? 'Please enter your practice or company name.' : 'Please enter your practice name.'}</div>
        </div>}
        {mode === 'audit' && <div class="form-row">
          <label for="websiteUrl">Practice website <span class="req">*</span></label>
          <input id="websiteUrl" type="url" placeholder="https://yourpractice.com" autocomplete="url" required>
          <div class="err">Please enter a valid website URL starting with https://.</div>
        </div>}
        {mode === 'audit' && !lean && <Fragment><div class="form-row full">
          <label for="country">Country <span class="req">*</span></label>
          <select id="country" autocomplete="country-name">
            <option value="">Select your country...</option>
            <option value="United States">United States</option>
            <option value="Canada">Canada</option>
            <option value="United Kingdom">United Kingdom</option>
            <option value="Ireland">Ireland</option>
            <option value="Australia">Australia</option>
            <option value="New Zealand">New Zealand</option>
            <option value="South Africa">South Africa</option>
            <option value="Other">Other</option>
          </select>
          <div class="err">Please select your country.</div>
        </div>
        <div class="form-row full">
          <label for="practiceAddress">Practice address <span class="req">*</span></label>
          <input id="practiceAddress" type="text" autocomplete="address-line1" placeholder="Street address" required>
          <div class="err">Please enter your practice street address.</div>
        </div>
        <div class="form-row full">
          <label for="practiceAddress2">Suite, floor, or unit (optional)</label>
          <input id="practiceAddress2" type="text" autocomplete="address-line2" placeholder="Suite 200">
        </div>
        <div class="form-row">
          <label for="practiceCity"><span id="cityLabelText">City</span> <span class="req">*</span></label>
          <input id="practiceCity" type="text" autocomplete="address-level2" required>
          <div class="err" id="cityErr">Please enter your city.</div>
        </div>
        <div class="form-row">
          <label for="practiceState"><span id="regionLabelText">State or province</span> <span class="req">*</span></label>
          <input id="practiceState" type="text" autocomplete="address-level1" required>
          <div class="err" id="regionErr">Please enter your state or province.</div>
        </div>
        <div class="form-row">
          <label for="postalCode"><span id="postalLabelText">Postal code</span> <span class="req">*</span></label>
          <input id="postalCode" type="text" autocomplete="postal-code" required>
          <div class="err" id="postalErr">Please enter your postal code.</div>
        </div>
        <div class="form-row">
          <label for="hasGbp">Do you have a Google Business Profile?</label>
          <select id="hasGbp">
            <option value="">Select...</option>
            <option value="yes">Yes</option>
            <option value="no">Not yet</option>
            <option value="unsure">Not sure</option>
          </select>
        </div>
        <div class="form-row is-hidden" id="gbpLinkRow">
          <label for="gbpLink">Google Business Profile link</label>
          <input id="gbpLink" type="url" placeholder="https://maps.app.goo.gl/...">
        </div></Fragment>}
        {mode === 'audit' && <Fragment><div class="form-row full">
          <label for="referralSource">How did you hear about Moonraker?</label>
          <select id="referralSource">
            <option value="">Select...</option>
            {/* "Google Ad" is its own option because without it every ad
                click that self-reports picks "Google Search", which makes
                paid and organic indistinguishable in the one field where
                the client tells us directly. */}
            <option value="Google Ad">Google Ad</option>
            <option value="Google Search">Google Search</option>
            <option value="Google Maps">Google Maps</option>
            <option value="AI Search (ChatGPT, Gemini, Claude, etc)">AI Search (ChatGPT, Gemini, Claude, etc)</option>
            <option value="Referral">Referral</option>
            <option value="Webinar">Webinar</option>
            <option value="Newsletter">Newsletter</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-row full">
          <label for="notes">Anything you'd like Scott to know in advance?</label>
          <textarea id="notes" rows="3" placeholder="Optional"></textarea>
        </div></Fragment>}
      </div>}

      <div class="submit-row">
        <button type="button" class="btn btn-ghost" onclick="goToStep(2)">Back</button>
        <button type="button" class="btn btn-primary" id="submitBtn" data-label={submitLabel} onclick="submitBooking()">{submitLabel}</button>
      </div>
      <div id="formError" class="error-state is-hidden"></div>
    </div>

    <!-- Step 4: confirmation -->
    <div class="booking-step confirm" id="step4" hidden>
      <div class="confirm-icon">&#10003;</div>
      <h2>{mode === 'reschedule' ? 'Your call is moved.' : "You're booked."}</h2>
      <p>{mode === 'reschedule'
        ? 'A fresh confirmation email is on its way and the calendar invite has been updated.'
        : 'A confirmation email is on its way with the Zoom link and a calendar invite. Scott will see you at your selected time.'}</p>
      <div class="confirm-details" id="confirmDetails"></div>
      <p class="confirm-note">{mode === 'reschedule'
        ? 'Need to change anything else? Reply to the confirmation email and we will sort it.'
        : 'Need to change anything? Reply to the confirmation email and we will sort it.'}</p>
    </div>

  </div>
</div>

<script is:inline>

(function () {
  'use strict';

  var API_ROOT = 'https://clients.moonraker.ai';

  // The widget root, read early: MODE drives the submit dispatch and boot
  // behavior below. See the component header for what each mode does.
  var root = document.getElementById('bookingWorkspace');
  var MODE = (root && root.getAttribute('data-mode')) || 'audit';

  // Returns null when the cookie is absent (pixel blocked, consent declined,
  // first paint not reached). The server treats a missing obref as optional.
  function readCookie(name) {
    try {
      var m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : null;
    } catch (e) { return null; }
  }

  var state = {
    tz: null,
    slots: [],          // raw slots from API
    daysIndex: {},      // attendee_date -> array of slots
    selectedDate: null,
    selectedSlot: null,
    booking: null,
    // reschedule mode only: read from the confirmation-email link (?b=&t=&from=)
    bookingId: null,
    token: null,
    fromIso: null
  };

  function detectTz() {
    try { return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'; }
    catch (e) { return 'UTC'; }
  }

  function fmtTzAbbr(tz) {
    try {
      var parts = new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'short' })
        .formatToParts(new Date());
      var n = parts.find(function (p) { return p.type === 'timeZoneName'; });
      return (n && n.value) || tz;
    } catch (e) { return tz; }
  }

  function fmtPerth(iso) {
    var d = new Date(iso);
    var time = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Australia/Perth', hour: 'numeric', minute: '2-digit', hour12: true
    }).format(d);
    return time;
  }

  // reschedule mode: the "Currently scheduled for" banner text.
  function fmtFriendly(iso, tz) {
    try {
      var d = new Date(iso);
      var date = new Intl.DateTimeFormat('en-US', {
        timeZone: tz, weekday: 'long', month: 'long', day: 'numeric'
      }).format(d);
      var time = new Intl.DateTimeFormat('en-US', {
        timeZone: tz, hour: 'numeric', minute: '2-digit', hour12: true
      }).format(d);
      return date + ' at ' + time + ' (' + fmtTzAbbr(tz) + ')';
    } catch (e) { return iso; }
  }

  // reschedule mode: hide every step and show the link-invalid card.
  function showErrorState(message) {
    var err = document.getElementById('stepError');
    if (!err) return;
    [1, 2, 3, 4].forEach(function (i) {
      var s = document.getElementById('step' + i);
      if (s) s.setAttribute('hidden', '');
    });
    if (message) {
      var helper = err.querySelector('.helper');
      if (helper) helper.textContent = message;
    }
    err.removeAttribute('hidden');
  }

  function populateTzPicker(currentTz) {
    var common = [
      'America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles',
      'America/Toronto', 'America/Vancouver',
      'Europe/London', 'Europe/Dublin', 'Europe/Paris', 'Europe/Berlin', 'Europe/Madrid',
      'Australia/Adelaide', 'Australia/Sydney', 'Australia/Perth', 'Australia/Brisbane',
      'Pacific/Auckland', 'Asia/Singapore', 'Africa/Johannesburg', 'UTC'
    ];
    if (common.indexOf(currentTz) === -1) common.unshift(currentTz);
    var sel = document.getElementById('tzPicker');
    common.forEach(function (tz) {
      var opt = document.createElement('option');
      opt.value = tz;
      opt.textContent = tz + ' (' + fmtTzAbbr(tz) + ')';
      if (tz === currentTz) opt.selected = true;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', function (e) {
      state.tz = e.target.value;
      document.getElementById('tzLabel').textContent = state.tz + ', ' + fmtTzAbbr(state.tz);
      if (MODE === 'reschedule' && state.fromIso) {
        setText('currentWhen', fmtFriendly(state.fromIso, state.tz));
      }
      // Changing the zone re-labels every slot AND re-groups slots into days
      // (a slot's local date can shift across the zone change), so the cached
      // day key in state.selectedDate is no longer valid. Clear the selection
      // and return to the date picker; loadAvailability re-renders the dates in
      // the new zone, and the time grid will rebuild from fresh data on the
      // next pick. Without this, a zone change made while viewing the time grid
      // leaves the old zone's times on screen.
      state.selectedDate = null;
      state.selectedSlot = null;
      clearNotice();
      goToStep(1);
      loadAvailability();
    });
  }

  function loadAvailability() {
    var dateStrip = document.getElementById('dateStrip');
    dateStrip.innerHTML = '<div class="loading-state">Loading availability...</div>';

    var fromDate = new Date();
    var toDate = new Date(fromDate.getTime() + 22 * 24 * 3600 * 1000);
    var fmtDate = function (d) {
      return d.getFullYear() + '-' +
        String(d.getMonth() + 1).padStart(2, '0') + '-' +
        String(d.getDate()).padStart(2, '0');
    };

    fetch(API_ROOT + '/api/booking/availability', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        from_date: fmtDate(fromDate),
        to_date: fmtDate(toDate),
        attendee_time_zone: state.tz
      })
    })
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
      .then(function (res) {
        if (!res.ok) {
          dateStrip.innerHTML = '<div class="error-state">' +
            (res.body && res.body.error ? res.body.error : 'Unable to load availability') +
            '</div>';
          return;
        }
        state.slots = res.body.slots || [];
        state.daysIndex = {};
        state.slots.forEach(function (s) {
          if (!state.daysIndex[s.attendee_date]) state.daysIndex[s.attendee_date] = [];
          state.daysIndex[s.attendee_date].push(s);
        });
        renderDates();
      })
      .catch(function () {
        dateStrip.innerHTML = '<div class="error-state">Unable to reach the booking service. Please refresh and try again.</div>';
      });
  }

  function renderDates() {
    var dateStrip = document.getElementById('dateStrip');
    var dates = Object.keys(state.daysIndex);
    if (dates.length === 0) {
      dateStrip.innerHTML = '<div class="empty-state">No openings in the next three weeks. Please email <a href="mailto:scott@moonraker.ai">scott@moonraker.ai</a> and we will find a time.</div>';
      return;
    }
    // Order by the underlying UTC of each day's first slot.
    dates.sort(function (a, b) {
      return new Date(state.daysIndex[a][0].start_utc) -
        new Date(state.daysIndex[b][0].start_utc);
    });
    var html = '';
    dates.forEach(function (d) {
      var slot0 = state.daysIndex[d][0];
      var dateObj = new Date(slot0.start_utc);
      var weekday = new Intl.DateTimeFormat('en-US', {
        timeZone: state.tz, weekday: 'short'
      }).format(dateObj);
      var dayNum = new Intl.DateTimeFormat('en-US', {
        timeZone: state.tz, day: 'numeric'
      }).format(dateObj);
      var monthShort = new Intl.DateTimeFormat('en-US', {
        timeZone: state.tz, month: 'short'
      }).format(dateObj);
      var count = state.daysIndex[d].length;
      html += '<button type="button" class="date-pill" data-date="' + d + '">' +
        '<div class="date-weekday">' + weekday + '</div>' +
        '<div class="date-day">' + dayNum + '</div>' +
        '<div class="date-month">' + monthShort + '</div>' +
        '<div class="date-count">' + count + ' open</div>' +
        '</button>';
    });
    dateStrip.innerHTML = html;
    dateStrip.querySelectorAll('.date-pill').forEach(function (el) {
      el.addEventListener('click', function () {
        selectDate(el.getAttribute('data-date'));
      });
    });
  }

  function selectDate(dateStr) {
    clearNotice();
    state.selectedDate = dateStr;
    document.querySelectorAll('.date-pill').forEach(function (el) {
      el.classList.toggle('selected', el.getAttribute('data-date') === dateStr);
    });
    renderTimes();
    goToStep(2);
  }

  function renderTimes() {
    var slots = state.daysIndex[state.selectedDate] || [];
    var grid = document.getElementById('timeGrid');
    document.getElementById('step2Title').textContent =
      'Pick a time on ' + (slots[0] ? slots[0].attendee_date : '');
    if (slots.length === 0) {
      grid.innerHTML = '<div class="empty-state">No times available on this day.</div>';
      return;
    }
    var html = '';
    slots.forEach(function (s, i) {
      html += '<button type="button" class="time-pill" data-idx="' + i + '">' +
        '<div class="t-main">' + s.attendee_time + '</div>' +
        '<div class="t-sub">' + fmtPerth(s.start_utc) + ' Perth</div>' +
        '</button>';
    });
    grid.innerHTML = html;
    grid.querySelectorAll('.time-pill').forEach(function (el) {
      el.addEventListener('click', function () {
        var i = Number(el.getAttribute('data-idx'));
        selectSlot(slots[i]);
      });
    });
  }

  function selectSlot(slot) {
    state.selectedSlot = slot;
    populateSummary();
    goToStep(3);
  }

  function populateSummary() {
    var s = state.selectedSlot;
    if (!s) return;
    document.getElementById('summaryWhen').textContent =
      s.attendee_date + ' at ' + s.attendee_time + ' (' + s.attendee_tz_label + ')';
    document.getElementById('summarySub').textContent = MODE === 'reschedule'
      ? 'That is ' + fmtPerth(s.start_utc) + ' Perth time. Same call length, same host.'
      : 'That is ' + fmtPerth(s.start_utc) + ' Perth time (Scott\'s zone). 30 minutes with Scott on Zoom.';
  }

  function showNotice(msg) {
    var el = document.getElementById('bookingNotice');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('is-hidden');
  }
  function clearNotice() {
    var el = document.getElementById('bookingNotice');
    if (el) el.classList.add('is-hidden');
  }

  window.goToStep = function (n) {
    [1, 2, 3, 4].forEach(function (i) {
      var el = document.getElementById('step' + i);
      if (i === n) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
    var errEl = document.getElementById('stepError');
    if (errEl) errEl.setAttribute('hidden', '');
    window.scrollTo({ top: document.querySelector('.booking-workspace').offsetTop - 24, behavior: 'smooth' });
  };

  // Absent on a lean page. el() is a hoisted function declaration below, so
  // it is safe to call here.
  var gbpEl = el('hasGbp');
  if (gbpEl) gbpEl.addEventListener('change', function (e) {
    document.getElementById('gbpLinkRow').classList.toggle('is-hidden', e.target.value !== 'yes');
  });

  // Country-aware address labels. Picking the country first re-labels the
  // region/postal/city fields to match local convention (State + ZIP for the
  // US, County + Postcode for the UK, etc). The field IDs and the submitted
  // payload do not change; only the visible labels and error copy do.
  var ADDRESS_LOCALE = {
    'United States':  { region: 'State',             postal: 'ZIP code',      city: 'City' },
    'Canada':         { region: 'Province',          postal: 'Postal code',   city: 'City' },
    'United Kingdom': { region: 'County',            postal: 'Postcode',      city: 'Town / City' },
    'Ireland':        { region: 'County',            postal: 'Eircode',       city: 'Town / City' },
    'Australia':      { region: 'State / Territory', postal: 'Postcode',      city: 'Suburb / City' },
    'New Zealand':    { region: 'Region',            postal: 'Postcode',      city: 'Town / City' },
    'South Africa':   { region: 'Province',          postal: 'Postal code',   city: 'City' }
  };
  var ADDRESS_LOCALE_DEFAULT = { region: 'State / Province / Region', postal: 'Postal code', city: 'City' };

  // On a lean page the address, practice-name and GBP fields are not
  // rendered at all, so every lookup below has to tolerate a null. el()
  // and val() are the only sanctioned way to touch a form field.
  function el(id) { return document.getElementById(id); }
  function val(id) { var e = el(id); return e ? e.value : ''; }
  function setText(id, text) { var e = el(id); if (e) e.textContent = text; }

  function applyAddressLocale(country) {
    var loc = ADDRESS_LOCALE[country] || ADDRESS_LOCALE_DEFAULT;
    setText('regionLabelText', loc.region);
    setText('postalLabelText', loc.postal);
    setText('cityLabelText', loc.city);
    setText('regionErr', 'Please enter your ' + loc.region.toLowerCase() + '.');
    setText('postalErr', 'Please enter your ' + loc.postal.toLowerCase() + '.');
    setText('cityErr', 'Please enter your ' + loc.city.toLowerCase() + '.');
  }

  var countryEl = el('country');
  if (countryEl) {
    countryEl.addEventListener('change', function (e) {
      applyAddressLocale(e.target.value);
    });
  }

  function setError(rowId, has) {
    var e = el(rowId);
    if (!e) return;
    e.closest('.form-row').classList.toggle('has-error', has);
  }

  function validate() {
    var ok = true;
    var checks = [
      ['firstName',       function (v) { return v.trim().length > 0; }],
      ['lastName',        function (v) { return v.trim().length > 0; }],
      ['email',           function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }],
      ['phone',           function (v) { return v.trim().length >= 6; }],
      ['practiceName',    function (v) { return v.trim().length > 0; }],
      ['websiteUrl',      function (v) { return /^https?:\/\/.+\..+/.test(v.trim()); }],
      ['country',         function (v) { return v.trim().length > 0; }],
      ['practiceAddress', function (v) { return v.trim().length > 0; }],
      ['practiceCity',    function (v) { return v.trim().length > 0; }],
      ['practiceState',   function (v) { return v.trim().length > 0; }],
      ['postalCode',      function (v) { return v.trim().length > 0; }]
    ];
    checks.forEach(function (c) {
      // A field that is not on the page is not a failed field. This is what
      // makes one validate() serve both the full and the lean form.
      if (!el(c[0])) return;
      var bad = !c[1](val(c[0]));
      setError(c[0], bad);
      if (bad) ok = false;
    });
    return ok;
  }

  // One submit entry point for all three modes; the endpoint and payload
  // differ, the button/error/409 handling is shared.
  function buildPayload() {
    if (MODE === 'reschedule') {
      return {
        booking_id: state.bookingId,
        token:      state.token,
        start_at:   state.selectedSlot.start_utc
      };
    }
    if (MODE === 'quick') {
      return {
        first_name:         val('firstName').trim(),
        last_name:          val('lastName').trim(),
        email:              val('email').trim(),
        practice_name:      val('practiceName').trim(),
        attendee_time_zone: state.tz,
        start_at:           state.selectedSlot.start_utc,
        source:             'quick_book',
        // OpenAI Ads match keys, see the audit payload note below.
        oai_obref:          readCookie('__obref'),
        source_url:         location.origin + location.pathname,
        attribution:        (window.mrAttribution && window.mrAttribution()) || null
      };
    }
    return {
      attendee_first_name:    val('firstName').trim(),
      attendee_last_name:     val('lastName').trim(),
      attendee_email:         val('email').trim(),
      attendee_phone:         val('phone').trim(),
      attendee_time_zone:     state.tz,
      practice_name:          val('practiceName').trim() || null,
      website_url:            val('websiteUrl').trim(),
      practice_address:       val('practiceAddress').trim() || null,
      practice_address_line2: val('practiceAddress2').trim() || null,
      practice_city:          val('practiceCity').trim() || null,
      practice_state:         val('practiceState').trim() || null,
      postal_code:            val('postalCode').trim() || null,
      country:                val('country').trim() || null,
      has_gbp:                val('hasGbp') === 'yes',
      gbp_link:               val('gbpLink').trim() || null,
      referral_source:        val('referralSource').trim() || null,
      start_at:               state.selectedSlot.start_utc,
      notes:                  val('notes').trim() || null,
      source:                 'free_strategy_call',
      // OpenAI Ads match keys. __obref is the pixel's first-party cookie and
      // is passed through unhashed; it lets the server-side conversion match
      // the same browser the ad click landed in.
      oai_obref:              readCookie('__obref'),
      source_url:             location.origin + location.pathname,
      // First-touch lead source captured on landing (see BaseLayout ATTRIB_JS).
      attribution:            (window.mrAttribution && window.mrAttribution()) || null
    };
  }

  var ENDPOINT = MODE === 'reschedule' ? '/api/booking/reschedule'
    : MODE === 'quick' ? '/api/booking/quick-book'
    : '/api/booking/create-with-audit';

  window.submitBooking = function () {
    if (!state.selectedSlot) return;
    if (MODE !== 'reschedule' && !validate()) return;

    var btn = document.getElementById('submitBtn');
    var btnLabel = btn.getAttribute('data-label') || 'Confirm booking';
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> ' + (MODE === 'reschedule' ? 'Moving...' : 'Booking...');
    document.getElementById('formError').classList.add('is-hidden');

    var payload = buildPayload();

    fetch(API_ROOT + ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b, status: r.status }; }); })
      .then(function (res) {
        btn.disabled = false;
        btn.innerHTML = btnLabel;
        if (!res.ok) {
          if (MODE === 'reschedule' && (res.status === 401 || res.status === 403)) {
            showErrorState();
            return;
          }
          var msg = (res.body && res.body.error) ||
            (MODE === 'reschedule' ? 'Reschedule failed. Please try again.' : 'Booking failed. Please try again.');
          if (res.status === 409) {
            // Slot disappeared (or, on reschedule, the booking already moved).
            // Reload availability and send the user back to the date picker.
            // The formError element lives inside step 3, which goToStep(1)
            // hides, so surface the reason in the always-visible notice banner
            // above the card instead.
            msg = MODE === 'reschedule'
              ? (msg || 'That time was taken while you were on this page. Please pick another.')
              : 'That time was taken while you were filling in the form. Please pick another.';
            loadAvailability();
            goToStep(1);
            showNotice(msg);
            return;
          }
          document.getElementById('formError').textContent = msg;
          document.getElementById('formError').classList.remove('is-hidden');
          return;
        }
        state.booking = res.body;
        if (MODE !== 'reschedule') {
          try { if (window.mrTrackConversion) window.mrTrackConversion(res.body && res.body.booking_id); } catch (e) {}
        }
        renderConfirmation(payload);
        goToStep(4);
      })
      .catch(function () {
        btn.disabled = false;
        btn.innerHTML = btnLabel;
        document.getElementById('formError').textContent = 'Network error. Please try again.';
        document.getElementById('formError').classList.remove('is-hidden');
      });
  };

  function renderConfirmation(payload) {
    var s = state.selectedSlot;
    var html = '';
    html += '<div class="detail-row"><span class="detail-label">' + (MODE === 'reschedule' ? 'New time' : 'When') + '</span>' +
      '<span class="detail-value">' + s.attendee_date + ' at ' + s.attendee_time + ' (' + s.attendee_tz_label + ')</span></div>';
    html += '<div class="detail-row"><span class="detail-label">Perth time</span>' +
      '<span class="detail-value">' + fmtPerth(s.start_utc) + '</span></div>';
    html += '<div class="detail-row"><span class="detail-label">Duration</span>' +
      '<span class="detail-value">30 minutes</span></div>';
    if (state.booking && state.booking.meeting_link) {
      html += '<div class="detail-row"><span class="detail-label">Zoom</span>' +
        '<span class="detail-value"><a href="' + state.booking.meeting_link + '" target="_blank" rel="noopener">Join link</a></span></div>';
    }
    var email = payload.attendee_email || payload.email;
    if (email) {
      html += '<div class="detail-row"><span class="detail-label">Confirmation sent to</span>' +
        '<span class="detail-value">' + email + '</span></div>';
    }
    document.getElementById('confirmDetails').innerHTML = html;
  }

  function startWorkspace() {
    state.tz = detectTz();
    document.getElementById('tzLabel').textContent = state.tz + ', ' + fmtTzAbbr(state.tz);
    populateTzPicker(state.tz);

    if (MODE === 'reschedule') {
      // booking_id, token, and (informational) original start_at from the
      // confirmation-email link.
      var rp;
      try { rp = new URLSearchParams(window.location.search); } catch (ex) { rp = null; }
      state.bookingId = rp && rp.get('b');
      state.token = rp && rp.get('t');
      state.fromIso = rp && rp.get('from');
      if (!state.bookingId || !state.token) {
        showErrorState('This page needs a valid reschedule link. Please use the link in your confirmation email.');
        return;
      }
      if (state.fromIso) {
        try {
          setText('currentWhen', fmtFriendly(state.fromIso, state.tz));
          document.getElementById('currentBanner').removeAttribute('hidden');
        } catch (ex) {
          // Bad ISO string. Just don't show the banner.
        }
      }
    }

    if (MODE === 'quick') {
      // Pre-fill email from ?email= (audit-email CTAs link here with it).
      try {
        var qp = new URLSearchParams(window.location.search);
        var qe = qp.get('email');
        var emailEl = el('email');
        if (qe && emailEl) emailEl.value = qe;
      } catch (ex) {}
    }

    loadAvailability();
  }

  // See the component header: `defer` boots this when it nears the
  // viewport instead of on load. Anyone who clicks a CTA scrolls to it,
  // which triggers the observer well before they can interact.
  if (root && root.getAttribute('data-defer') === '1' && 'IntersectionObserver' in window) {
    var started = false;
    var io = new IntersectionObserver(function (entries) {
      if (started || !entries.some(function (e) { return e.isIntersecting; })) return;
      started = true; io.disconnect(); startWorkspace();
    }, { rootMargin: '600px 0px' });
    io.observe(root);
  } else {
    startWorkspace();
  }
})();

</script>

<!-- Rules are plain selectors, NOT :global(). The block is already global;
     Astro only strips a :global() wrapper inside SCOPED style blocks, so
     leaving it here emits literal :global(...) that browsers discard. -->
<!-- Below-the-fold widget CSS, off the critical path (oi-172). media="print"
     downloads without blocking render; onload flips it to all. The noscript
     copy keeps the widget styled when JS is off, which also keeps the
     no-JS booking fallback readable. -->
<link rel="stylesheet" href={bookingCssUrl} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={bookingCssUrl} /></noscript>

<style is:global>
/* CRITICAL subset only. Everything else is in src/styles/booking-widget.css,
   loaded asynchronously above. These rules reserve the widget's box and style
   what is on screen first, so the async sheet landing does not shift layout. */
.tz-banner {
  margin: 0 0 1.25rem;
  background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-primary) 32%, transparent);
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  border-radius: var(--r-lg); padding: 1rem 1.25rem;
  display: flex; gap: 1rem; align-items: center;
  font-size: .85rem; color: var(--color-body); line-height: 1.5;
  text-align: left;
}
.tz-banner-icon { font-size: 1.25rem; flex-shrink: 0; }
/* On the banner's tinted background the brand green reads 1.9:1. Use the
   readable green, and let the body colour carry the secondary lines: the
   muted grey lands at 4.49:1 here, just under AA. */
/* Measured 4.47:1 against this banner's 12% green tint, three hundredths
   short of AA. Darkening the global green token for one element would be
   the wrong lever, so this emphasis line uses the heading ink instead. */
.tz-banner strong { color: var(--color-heading); font-weight: 700; }
.tz-banner-line { margin-top: .35rem; }
.tz-banner select {
  margin-top: .35rem; font-family: inherit; font-size: .82rem;
  padding: .3rem .5rem; border: 1px solid var(--color-border);
  border-radius: 6px; background: var(--color-bg); color: var(--color-body);
}
.tz-banner select:focus { outline: none; border-color: var(--color-primary); }
/* Booking notice banner (shown above the card, e.g. when a slot is taken). */
.booking-notice {
  margin: 0 0 1rem; padding: .85rem 1.1rem;
  border-radius: var(--r-md); font-size: .88rem; line-height: 1.5;
  background: color-mix(in srgb, var(--color-danger) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-danger) 35%, transparent);
  color: var(--color-danger);
}
/* reschedule mode: the "Currently scheduled for" banner. */
.current-banner {
  margin: 0 0 1.25rem;
  background: var(--color-surface); border: 1px solid var(--color-border);
  border-radius: var(--r-lg); padding: 1rem 1.25rem;
  display: flex; gap: 1rem; align-items: center;
  font-size: .9rem; color: var(--color-body); line-height: 1.5;
  text-align: left;
}
.current-banner-icon { font-size: 1.25rem; flex-shrink: 0; }
.current-banner strong { color: var(--color-heading); font-weight: 600; }
.current-help { margin-top: .25rem; color: var(--color-muted); }
/* Booking workspace */
.booking-workspace {
  max-width: 1080px; margin: clamp(3rem, 6vw, 5rem) auto 4rem;
  padding: 0 2rem;
}
.booking-card {
  background: var(--color-surface); border: 1px solid var(--color-hairline);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.booking-step { padding: 2rem; }
.booking-step h2 {
  font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.25rem;
  color: var(--color-heading); margin-bottom: 1.25rem;
}
.booking-step p.helper {
  color: var(--color-muted); font-size: .85rem;
  margin: -.75rem 0 1.5rem; line-height: 1.6;
}
.loading-state, .empty-state, .error-state {
  text-align: center; padding: 2.5rem 1rem; color: var(--color-muted); font-size: .9rem;
}
.is-hidden { display: none; }
</style>
