---
/**
 * Reschedule page for an existing strategy-call booking. The slot picker,
 * token handling (?b=&t=&from=), current-booking banner, and link-invalid
 * state are BookingWidget in mode="reschedule" (POST /api/booking/reschedule);
 * this page only owns the header band. Folded from a full inline copy on
 * 2026-08-03 (ledger oi-038). Sweep companion: the booking-ui-sweep skill.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingWidget from '../components/BookingWidget.astro';
---
<BaseLayout title="Reschedule your call - Moonraker" description="Pick a new time for your strategy call with Scott." ogTitle="Reschedule your call - Moonraker" ogUrl="https://moonraker.ai/reschedule">
<main>

<div class="contact-wrap">
  <div class="contact-header">
    <h1>Reschedule your call</h1>
    <p>Pick a new time for your strategy call with Scott. We'll move the calendar invite and send a fresh confirmation.</p>
  </div>
</div>

<BookingWidget mode="reschedule" />

</main>
</BaseLayout>
<style>
/* Header band only; the booking UI styles live with BookingWidget
   (src/styles/booking-widget.css + the component's critical subset). */
.contact-wrap {
  position: relative; overflow: hidden;
  background: linear-gradient(180deg, var(--color-primary-subtle) 0%, var(--color-bg) 62%);
  border-bottom: 1px solid var(--color-hairline);
  padding: 3rem 2rem 2rem;
}
.contact-wrap::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    linear-gradient(to right, oklch(0.31 0.072 268 / 0.045) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(0.31 0.072 268 / 0.045) 1px, transparent 1px);
  background-size: 62px 62px;
  -webkit-mask-image: radial-gradient(70% 90% at 50% 0%, #000 0%, transparent 78%);
  mask-image: radial-gradient(70% 90% at 50% 0%, #000 0%, transparent 78%);
  pointer-events: none;
}
html.dark .contact-wrap::before {
  background-image:
    linear-gradient(to right, oklch(0.945 0.018 166 / 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(0.945 0.018 166 / 0.05) 1px, transparent 1px);
}
.contact-wrap > * { position: relative; z-index: 1; }
.contact-header { max-width: 720px; margin: 0 auto; text-align: center; }
.contact-header h1 {
  font-family: 'Outfit', sans-serif; font-weight: 800;
  font-size: 2.5rem; line-height: 1.15; color: var(--color-heading);
  margin-bottom: 1rem; letter-spacing: -.01em;
}
.contact-header p {
  font-size: 1rem; color: var(--color-muted);
  line-height: 1.65; margin-bottom: 1.5rem;
}
@media (max-width: 720px) {
  .contact-header h1 { font-size: 1.85rem; }
}
</style>
