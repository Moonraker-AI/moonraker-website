---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Same booking component as every other surface, so the paid page converts
// inline instead of spending a click sending people elsewhere.
import BookingWidget from '../../components/BookingWidget.astro';
import StatsStrip from '../../components/StatsStrip.astro';

/**
 * Paid landing page for the WEBSITE cluster: "websites for therapists",
 * "therapist website design", "therapy website design", "counseling
 * website design", "private practice website".
 *
 * Why this page exists, and why it is not just /lp/strategy-call:
 * that page sells a visibility strategy call, and Google scored its
 * landing page experience BELOW AVERAGE on every keyword in this cluster.
 * The cluster was 48 percent of campaign spend and converted at zero. The
 * searcher is shopping for a WEBSITE, so the page has to answer the
 * website question first and earn the call second.
 *
 * Not in sitemap.xml.ts on purpose: paid landing pages are excluded there
 * so they cannot compete with /services in organic results.
 *
 * The style block is a deliberate copy of the one in strategy-call.astro.
 * Astro scopes page styles at build time, and promoting these class names
 * (section-wrap, cta-band, faq-list) to a shared global sheet would leak
 * them onto pages that define the same names differently.
 */
---
<BaseLayout
  title="Therapist Website Design That Gets Found | Moonraker"
  description="Websites for therapy practices, built to be found on Google, Maps, and AI tools. Fast, secure, and written around how clients actually search. Start with a free 30-minute review."
  bare
>
<main>
  <section class="lp-hero">
    <div class="hero-inner">
      <div>
        <h1>A therapy website clients <span style="color: var(--color-primary)">actually find.</span></h1>
        <p>Most therapist websites look fine and get found by nobody. We build practice websites on a fast, secure foundation, structured around the services and questions your future clients are really searching, on Google, in Maps, and inside AI tools like ChatGPT and Gemini.</p>
        <div class="hero-cta">
          <a class="btn btn-primary lp-cta" href="#book">Get a Free Website Review</a>
        </div>
        <p class="hero-reassure">30 minutes, no cost, no obligation. You leave knowing what your current site is costing you.</p>
      </div>
      <div class="hero-points">
        <div class="hero-point"><strong>Built for how clients search</strong><span>A page for every service and location you want to be found for, not one page that mentions everything.</span></div>
        <div class="hero-point"><strong>Fast and secure by default</strong><span>Hosted on Cloudflare. No plugins to update, nothing to break, nothing to get hacked.</span></div>
        <div class="hero-point"><strong>Written to convert</strong><span>Clear next steps, real availability, and a booking path that works on a phone.</span></div>
      </div>
    </div>
  </section>

  <section class="partners-band">
    <div class="section-wrap">
      <h2 class="partners-heading">Trusted by the experts who educate therapists</h2>
      <div class="partner-row">
        <img class="partner-logo" src="/assets/partners/psychology-business-school-h160.avif" alt="Psychology Business School logo" width="900" height="660" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/private-practice-elevation-h160.avif" alt="Private Practice Elevation logo" width="285" height="150" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/traveling-therapist-h160.avif" alt="The Traveling Therapist logo" width="300" height="264" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/private-practice-academy-h160.avif" alt="The Private Practice Academy logo" width="900" height="206" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/therasaas-h160.avif" alt="TheraSaaS logo" width="350" height="180" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/intensive-therapy-coach-h160.avif" alt="Intensive Therapy Coach logo" width="1000" height="565" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/prosperous-therapist-h160.avif" alt="The Prosperous Therapist logo" width="300" height="100" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/mccance-method-h160.avif" alt="The McCance Method logo" width="500" height="320" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <StatsStrip />

  <section class="steps-band">
    <div class="section-wrap">
      <div class="section-head">
        <div><div class="section-label">What you get</div><h2>A website that does the finding for you.</h2></div>
        <p>A pretty site that nobody finds is a brochure. Every practice site we build is designed around the search that brings a client to your door.</p>
      </div>
      <div class="steps-grid">
        <article class="step-card"><div class="step-num">1</div><h3>Pages for what you treat</h3><p>Anxiety, trauma, couples, teens, intensives: a real page for each service you want clients to find, in the language they actually type, not clinical shorthand.</p></article>
        <article class="step-card"><div class="step-num">2</div><h3>Found by Google and AI</h3><p>Structured data, clean headings, and machine-readable copy so Google Maps, Google Search, and AI assistants can all describe your practice correctly.</p></article>
        <article class="step-card"><div class="step-num">3</div><h3>Built to book</h3><p>Your availability, your intake, your phone number, one tap away on mobile. The site's job is a booked consult, not a compliment.</p></article>
      </div>
      <div class="steps-cta"><a class="btn btn-primary lp-cta" href="#book">Get a Free Website Review</a></div>
    </div>
  </section>

  <section class="band-paper">
    <div class="section-wrap">
    <div class="section-head">
      <div><div class="section-label">Sites we built</div><h2>Real practices. Real scores.</h2></div>
      <p>Every number below is Google's own PageSpeed result for the live homepage on a mobile phone, measured 30 July 2026. We ran each site three times and published the WORST result, not the best. Open the sites, run the test yourself, and check us.</p>
    </div>

    <div class="case-grid">
      <article class="case-card">
        {/* Real screenshots of the live homepages, captured at 1280x760 and
            served at 760 wide. Below the fold, so lazy, and with intrinsic
            width/height because an unsized image here would shift the whole
            card as it decodes. The shot links to the live site, same target as
            the Visit link at the foot of the card, because a prospect's first
            instinct is to click the picture. aria-label names the destination
            so the link is not announced as the long descriptive alt text. */}
        <div class="case-shot">
          <a class="case-shot-link" href="https://anaffairoftheheart.us"
             target="_blank" rel="noopener"
             aria-label="Open the An Affair of the Heart homepage in a new tab">
            <img src="/assets/case-studies/an-affair-of-the-heart-hero.avif"
                 alt="The An Affair of the Heart homepage: a couple at sunset behind the headline Heal your relationship with a year of therapy in one week."
                 width="760" height="451" loading="lazy" decoding="async">
          </a>
        </div>
        <div class="case-head">
          <h3>An Affair of the Heart</h3>
          <p class="case-what">Private intensive couples retreats, Northampton, MA. Marriage crisis, infidelity recovery, and rebuilding trust, one couple at a time.</p>
        </div>
        <div class="score-row">
          <div class="score"><span class="score-val">97</span><span class="score-cat">Performance</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">Accessibility</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">Best practices</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">SEO</span></div>
        </div>
        <p class="case-detail">Loads its main content in 1.7 seconds on a phone, at 123 KB for the whole page. Zero layout shift, so nothing jumps while a visitor is reading.</p>
        <a class="case-link" href="https://anaffairoftheheart.us" target="_blank" rel="noopener">Visit anaffairoftheheart.us &rarr;</a>
      </article>

      <article class="case-card">
        <div class="case-shot">
          <a class="case-shot-link" href="https://intensivetherapyretreat.com"
             target="_blank" rel="noopener"
             aria-label="Open the Intensive Therapy Retreats homepage in a new tab">
            <img src="/assets/case-studies/intensive-therapy-retreats-hero.avif"
                 alt="The Intensive Therapy Retreats homepage: a still mountain lake behind the headline Experience life-changing transformation in just one week."
                 width="760" height="451" loading="lazy" decoding="async">
          </a>
        </div>
        <div class="case-head">
          <h3>Intensive Therapy Retreats</h3>
          <p class="case-what">One-on-one intensive retreats for trauma, PTSD, and abuse survivors. EMDR, IFS, and ART across multiple locations, with a 90-page site.</p>
        </div>
        <div class="score-row">
          <div class="score"><span class="score-val">96</span><span class="score-cat">Performance</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">Accessibility</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">Best practices</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">SEO</span></div>
        </div>
        <p class="case-detail">A 90-page practice site that still scores in the mid nineties on a phone, and 100 across every category on desktop. Every page is editable by the practice itself.</p>
        <a class="case-link" href="https://intensivetherapyretreat.com" target="_blank" rel="noopener">Visit intensivetherapyretreat.com &rarr;</a>
      </article>

      {/* Score row earned back on 2026-07-30. This card shipped without one
          that morning because Revibe measured 74 mobile with LCP 6.3s, and
          inventing a kinder number was not an option. Deferring the Google
          tag off the critical path took it to 92 (worst of three runs), so
          the numbers are real now. It stays the lowest of the three because
          it is the only one of these sites carrying a full GA4 plus Google
          Ads stack, which costs roughly 300 KB no matter how it is loaded. */}
      <article class="case-card">
        <div class="case-shot">
          <a class="case-shot-link" href="https://revibetherapy.com"
             target="_blank" rel="noopener"
             aria-label="Open the Revibe Therapy homepage in a new tab">
            <img src="/assets/case-studies/revibe-therapy-hero.avif"
                 alt="The Revibe Therapy homepage: the headline Therapy That Gets to the Root beside a free consultation form."
                 width="760" height="451" loading="lazy" decoding="async">
          </a>
        </div>
        <div class="case-head">
          <h3>Revibe Therapy</h3>
          <p class="case-what">Group practice in Winter Park and Lake Nona, FL. Cognitive hypnotherapy and EMDR for adults, teens, and athletes, in English and Spanish.</p>
        </div>
        <div class="score-row">
          <div class="score"><span class="score-val">92</span><span class="score-cat">Performance</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">Accessibility</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">Best practices</span></div>
          <div class="score"><span class="score-val">100</span><span class="score-cat">SEO</span></div>
        </div>
        <div class="case-tags">
          <span class="case-tag">Fully bilingual</span>
          <span class="case-tag">WordPress replaced</span>
          <span class="case-tag">Paid ads never paused</span>
        </div>
        <p class="case-detail">Every page exists in English and Spanish, and it carries a full analytics and ad-tracking stack without paying for it in speed. Their live Google Ads landing pages kept working through the whole rebuild, all 18 of them, so not one campaign had to be paused or rewritten.</p>
        <a class="case-link" href="https://revibetherapy.com" target="_blank" rel="noopener">Visit revibetherapy.com &rarr;</a>
      </article>
    </div>

    <p class="case-note">Scores from Google PageSpeed Insights, mobile, homepage, 30 July 2026, lowest of three consecutive runs. Performance moves a few points run to run on any site, including ours, which is why the worst run is the one printed. The other three categories do not move.</p>
    </div>
  </section>

  <section class="band-mint">
    <div class="section-wrap">
    <div class="reviews-head">
      <div class="section-label">Verified Google reviews</div>
      <h2>Therapists we built for, in their own words.</h2>
    </div>
    <div class="reviews-grid">
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"Chris is amazing! We experienced a significant increase in traffic and inquiries through our website with his SEO knowledge. His honesty and transparency stand out."</p>
        <div class="review-author"><div class="review-avatar">EE</div><div><div class="review-name">Erinn Everhart</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"In a very short amount of time Chris significantly improved the inbound traffic on my website. A significant chunk of the new business we have gained this past year is due to Chris and the excellent work he does at Moonraker."</p>
        <div class="review-author"><div class="review-avatar">CB</div><div><div class="review-name">Christopher Bagg</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"The results are amazing. Clicks, impressions, and my average position have all improved significantly. People are finding me through Google more than ever before."</p>
        <div class="review-author"><div class="review-avatar">AS</div><div><div class="review-name">Audrey Schoen, LMFT</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"I am not tech-savvy in any way. Chris is so knowledgeable and explains things in a way I can understand without being condescending. It is refreshing to work with someone as passionate about the mental health field as I am."</p>
        <div class="review-author"><div class="review-avatar">J</div><div><div class="review-name">Jennifer</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"I honestly think Moonraker is the best choice anyone could make for digital marketing. I never would have attracted the clients I have, in the volume I have, without Chris' expertise."</p>
        <div class="review-author"><div class="review-avatar">BR</div><div><div class="review-name">Bambi Rattner, PsyD</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"Chris was responsive, answered our questions clearly, and explained things in a way that made sense. His help improved our SEO, and we appreciate his expertise. Highly recommend!"</p>
        <div class="review-author"><div class="review-avatar">KS</div><div><div class="review-name">Kelly Smyth-Dent</div><div class="review-meta">Google review</div></div></div>
      </article>
    </div>
    </div>
  </section>

  <section class="band-paper">
    <div class="section-wrap">
    <div class="section-head">
      <div><div class="section-label">Two ways in</div><h2>Keep your site, or let us rebuild it.</h2></div>
      <p>You do not have to start over to be found. We recommend the smaller option whenever it solves the problem, and we tell you which one you need on the call.</p>
    </div>
    <div class="ladder-stack">
      <div class="ladder-preview"><div class="ladder-num">1</div><div><h3>Platform Upgrade</h3><p>Your current site moved page for page onto our fast, secure Cloudflare foundation, with the visibility gaps fixed on the way across. Your design, your content, none of the slowness.</p></div></div>
      <div class="ladder-preview"><div class="ladder-num">2</div><div><h3>Full Practice Rebuild</h3><p>A full redesign plus the service, location, and FAQ pages your practice is missing, built from scratch around what your clients search. Flat rate, quoted in writing.</p></div></div>
    </div>
    </div>
  </section>

  <section class="band-sage">
    <div class="section-wrap faq-wrap">
    <div class="section-label">Quick answers</div>
    <h2>Before you book.</h2>
    <div class="faq-list">
      <details open name="lp-faq"><summary>Do I own the website?</summary><p>Yes. The site is yours, and so is the content. If you ever leave us, we hand it over in a form you or any other developer can keep running. No hostage hosting.</p></details>
      <details name="lp-faq"><summary>I am on Squarespace, Wix, or WordPress. Do I have to move?</summary><p>Not always. If the builder is the thing holding your visibility back we will say so, but plenty of practices only need the structure and content fixed where they already are. That is the smaller of the two options above.</p></details>
      <details name="lp-faq"><summary>Will I lose my Google rankings if the site moves?</summary><p>No. We map every existing page to its new address with real redirects before launch, so the ranking you already earned follows you across. It is the single most common way a redesign quietly destroys a practice, and it is the first thing we plan.</p></details>
      <details name="lp-faq"><summary>How long does it take?</summary><p>An upgrade of an existing site is usually a couple of weeks. A full rebuild depends on how many service pages your practice needs, and you approve each page before it goes live.</p></details>
      <details name="lp-faq"><summary>What does it cost?</summary><p>Every engagement is a flat-rate project quoted in writing after the call, never hourly and never a retainer you have to escape. You see the number before you commit to anything.</p></details>
      <details name="lp-faq"><summary>Who do you work with?</summary><p>Therapy practices only: solo practitioners, group practices, and intensives or retreats. That focus is why the review is fast and the recommendations are specific.</p></details>
    </div>
    </div>
  </section>

  <section class="cta-band" id="book">
    <div class="cta-inner cta-inner-stacked">
      <div>
        <h2>See what your website is costing you.</h2>
        <p>Pick a time below. Scott walks through your current site live, shows you what clients searching for your services actually see, and tells you whether a fix or a rebuild is the honest answer. Free, 30 minutes, over Zoom.</p>
      </div>
    </div>
  </section>

  {/* lean: paid traffic gets the short intake. The full address block stays
      on /free-strategy-call, where the visitor arrived warm. */}
  <BookingWidget defer lean />
</main>
</BaseLayout>

<style>
.lp-hero { position: relative; overflow: hidden; background: linear-gradient(158deg, var(--color-navy) 0%, var(--color-navy-deep) 100%); color: var(--color-on-navy-dim); padding: clamp(3.75rem, 6.5vw, 5rem) 2rem; }
.lp-hero::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    linear-gradient(to right, oklch(0.945 0.018 166 / 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(0.945 0.018 166 / 0.05) 1px, transparent 1px);
  background-size: 62px 62px;
  -webkit-mask-image: radial-gradient(80% 120% at 50% 0%, #000 0%, transparent 72%);
  mask-image: radial-gradient(80% 120% at 50% 0%, #000 0%, transparent 72%);
  pointer-events: none;
}
.lp-hero .hero-inner { position: relative; z-index: 1; }
.hero-inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 6vw, 4rem); align-items: center; }
.lp-hero h1 { color: var(--color-on-navy); font-size: clamp(2.4rem, 4.6vw, 4.2rem); line-height: 1.05; letter-spacing: -.02em; margin-bottom: 1.1rem; }
.lp-hero p { color: var(--color-on-navy-dim); font-size: 1.08rem; line-height: 1.75; }
.hero-cta { margin-top: 1.6rem; }
.hero-reassure { margin-top: .9rem; font-size: .88rem; opacity: .85; }
.lp-cta { font-size: 1.02rem; padding: .9rem 1.6rem; }
.hero-points { display: grid; gap: .8rem; }
.hero-point { display: grid; gap: .3rem; padding: 1.1rem 1.25rem; border: 1px solid oklch(0.945 0.018 166 / 0.16); border-radius: var(--r-lg); background: oklch(0.945 0.018 166 / 0.05); }
.hero-point strong { font-family: 'Outfit', sans-serif; color: var(--color-on-navy); font-size: 1rem; }
.hero-point span { font-size: .9rem; line-height: 1.6; color: var(--color-on-navy-dim); }
.section-wrap { max-width: 1120px; margin: 0 auto; padding: clamp(3.5rem, 6vw, 5rem) 2rem; }
.section-label { color: var(--color-primary-text); font-weight: 800; font-size: .74rem; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .7rem; }
.section-head { display: grid; grid-template-columns: .9fr 1.1fr; gap: 2rem; margin-bottom: 2rem; align-items: end; }
.section-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); }
.section-head p { color: var(--color-muted); line-height: 1.75; }
.reviews-head { margin-bottom: 1.75rem; }
.reviews-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); }
/* Flex rather than grid so a trailing partial row CENTERS instead of hanging
   left. With grid the odd card out sits under column one and reads like a
   mistake. */
.reviews-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
.review-card { flex: 1 1 300px; max-width: 360px; background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--r-lg); padding: 1.4rem; display: grid; gap: .8rem; align-content: start; }
/* Exactly three across, unlike .reviews-grid above. There are only ever three
   case studies, so a flex basis plus max-width let them grow to 380px and wrap
   2 + 1 inside the 1052px wrap, orphaning the third. A fixed 3-column grid is
   the honest expression of "three sites side by side" and cannot orphan. Cards
   stretch to equal height, so the Visit link is pushed to the bottom below to
   keep the three links on one baseline. */
/* minmax(0, 1fr), not 1fr: a bare 1fr track refuses to shrink below the card's
   min-content width (the 4-up score row sets a wide floor), which pushed the
   row to 1228px inside a 1052px wrap and gave the whole page a horizontal
   scrollbar. minmax(0, ...) lets the track shrink and the text reflow instead. */
/* align-items:start, not stretch: Revibe's card carries an extra tag row and a
   much longer detail paragraph, so equal-height cards left a ~250px dead void
   in the other two. Natural heights with a ragged bottom reads as intentional;
   a void does not. Tops, screenshots, headings and score rows still align. */
.case-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
.case-card { background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--r-lg); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
.case-shot { border: 1px solid var(--color-hairline); border-radius: 12px; overflow: hidden; background: var(--band-sage); line-height: 0; }
.case-shot img { display: block; width: 100%; height: auto; }
/* The whole screenshot is a link to the live site, so a visitor does not have
   to hunt for the text link underneath. Block wrapper because the img is the
   only child and line-height:0 on the parent already removes descender slack. */
.case-shot-link { display: block; transition: opacity .18s ease, transform .18s ease; }
.case-shot-link:hover { opacity: .92; transform: translateY(-2px); }
.case-shot-link:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; border-radius: 12px; }
/* No margin-top:auto pin here: with align-items:start the cards are their
   natural height, so a pin would do nothing except reintroduce the void. */
.case-head h3 { margin-bottom: .4rem; }
.case-what { color: var(--color-muted); font-size: .9rem; line-height: 1.6; }
/* 2x2, not 4 across. Three cards to a row makes each card 339px, leaving ~66px
   per tile at 4-up: "PERFORMANCE" and "ACCESSIBILITY" are single unbreakable
   words wider than that, so they clipped mid-word. Two columns gives each tile
   ~141px, which fits the longest label outright. minmax(0, ...) so the track
   can still shrink rather than pushing the tile through the card border. */
.score-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
.score { display: grid; gap: .15rem; justify-items: center; text-align: center; padding: .65rem .3rem; border: 1px solid var(--color-hairline); border-radius: 12px; background: var(--band-sage); }
.score-val { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.4rem; color: var(--color-primary-text); line-height: 1; }
.score-cat { font-size: .62rem; text-transform: uppercase; letter-spacing: .04em; color: var(--color-muted); line-height: 1.2; }
.case-tags { display: flex; flex-wrap: wrap; gap: .4rem; }
.case-tag { font-size: .74rem; font-weight: 600; padding: .35rem .6rem; border-radius: 999px; background: var(--band-sage); border: 1px solid var(--color-hairline); color: var(--color-primary-text); }
