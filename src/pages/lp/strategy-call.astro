---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Paid traffic converts on a lead form, not the calendar. The booking
// widget offered US visitors Perth-morning slots (7:30 PM to midnight
// Eastern) and cold clicks would not take them: 88 paid sessions, zero
// bookings, 2026-07/08. The audit form asks for what Scott needs and the
// call becomes the warm follow-up instead of the cold first step.
import LpAuditForm from '../../components/LpAuditForm.astro';
import LoomFacade from '../../components/LoomFacade.astro';
import StatsStrip from '../../components/StatsStrip.astro';
---
<BaseLayout
  title="Free Local Visibility Audit for Therapy Practices | Moonraker"
  description="See exactly where your practice stands on Google, Maps, and AI tools like ChatGPT. A free local visibility audit, prepared personally by a team that works only with therapy practices."
  bare
>
<main>
  <section class="lp-hero">
    <div class="hero-inner">
      <div>
        <h1>Get your practice found on <span style="color: var(--color-primary)">Google and AI.</span></h1>
        <p>Start with a free local visibility audit. We check how your practice shows up across Google, Maps, and AI tools like ChatGPT and Gemini, then email you exactly what is working, what is missing, and what to fix first.</p>
        <div class="hero-cta">
          <a class="btn btn-primary lp-cta" href="#book">Get My Free Visibility Audit</a>
        </div>
      </div>
      <div class="hero-video">
        <LoomFacade
          id="df3a5aa47f284ade81a4649695ac42dd"
          poster="strategy-call-video-poster"
          label="Play video: what a free strategy call with Moonraker looks like" />
        <p class="video-caption">Watch Chris explain how we look at a practice's visibility.</p>
      </div>
    </div>
  </section>

  <section class="partners-band">
    <div class="section-wrap">
      <h2 class="partners-heading">Trusted by the experts who educate therapists</h2>
      <div class="partner-row">
        <img class="partner-logo" src="/assets/partners/private-practice-elevation-h160.avif" alt="Private Practice Elevation logo" width="285" height="150" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/traveling-therapist-h160.avif" alt="The Traveling Therapist logo" width="300" height="264" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/private-practice-academy-h160.avif" alt="The Private Practice Academy logo" width="900" height="206" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/therasaas-h160.avif" alt="TheraSaaS logo" width="350" height="180" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/intensive-therapy-coach-h160.avif" alt="Intensive Therapy Coach logo" width="1000" height="565" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/prosperous-therapist-h160.avif" alt="The Prosperous Therapist logo" width="300" height="100" loading="lazy" decoding="async">
        <img class="partner-logo" src="/assets/partners/mccance-method-h160.avif" alt="The McCance Method logo" width="500" height="320" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <StatsStrip />

  <section class="band-mint">
    <div class="section-wrap">
    <div class="reviews-head">
      <div class="section-label">Verified Google reviews</div>
      <h2>Therapists we work with, in their own words.</h2>
    </div>
    <div class="reviews-grid">
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"I honestly think Moonraker is the best choice anyone could make for digital marketing. I never would have attracted the clients I have, in the volume I have, without Chris' expertise."</p>
        <div class="review-author"><div class="review-avatar">BR</div><div><div class="review-name">Bambi Rattner, PsyD</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"I had no idea how much of an impact SEO could have on my business until I connected with Chris. Within just eight months my returns had already doubled."</p>
        <div class="review-author"><div class="review-avatar">G</div><div><div class="review-name">George M.</div><div class="review-meta">Practice owner, Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"The results are amazing. Clicks, impressions, and my average position have all improved significantly. People are finding me through Google more than ever before."</p>
        <div class="review-author"><div class="review-avatar">AS</div><div><div class="review-name">Audrey Schoen, LMFT</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"Chris is amazing! We experienced a significant increase in traffic and inquiries through our website with his SEO knowledge. His honesty and transparency stand out."</p>
        <div class="review-author"><div class="review-avatar">EE</div><div><div class="review-name">Erinn Everhart</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"If you are a therapist looking for SEO strategy and implementation, Chris and his Moonraker team know how to rank you high on Google. I highly recommend them."</p>
        <div class="review-author"><div class="review-avatar">BS</div><div><div class="review-name">Brent Stutzman</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"In a very short amount of time Chris significantly improved the inbound traffic on my website. A significant chunk of the new business we have gained this past year is due to Chris and the excellent work he does at Moonraker."</p>
        <div class="review-author"><div class="review-avatar">CB</div><div><div class="review-name">Christopher Bagg</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"I am not tech-savvy in any way. Chris is so knowledgeable and explains things in a way I can understand without being condescending. It is refreshing to work with someone as passionate about the mental health field as I am."</p>
        <div class="review-author"><div class="review-avatar">J</div><div><div class="review-name">Jennifer</div><div class="review-meta">Google review</div></div></div>
      </article>
      <article class="review-card">
        <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="review-quote">"Chris was responsive, answered our questions clearly, and explained things in a way that made sense. His help improved our SEO, and we appreciate his expertise. Highly recommend!"</p>
        <div class="review-author"><div class="review-avatar">KS</div><div><div class="review-name">Kelly Smyth-Dent</div><div class="review-meta">Google review</div></div></div>
      </article>
    </div>
  </section>

  <section class="steps-band">
    <div class="section-wrap">
      <div class="section-head">
        <div><div class="section-label">What's in your audit</div><h2>Three clear answers, no meeting required.</h2></div>
        <p>No pitch deck and no pressure. Scott checks your real listings and pages by hand, and you know where you stand whether we ever work together or not.</p>
      </div>
      <div class="steps-grid">
        <article class="step-card"><div class="step-num">1</div><h3>Where you stand today</h3><p>How your practice actually appears on Google, Maps, and AI tools like ChatGPT and Gemini, checked against your real listings and pages.</p></article>
        <article class="step-card"><div class="step-num">2</div><h3>The gaps costing you clients</h3><p>Exactly what is holding your visibility back: missing pages, unclear services, inconsistent listings, or a site platform working against you.</p></article>
        <article class="step-card"><div class="step-num">3</div><h3>What to fix first</h3><p>A short, prioritized list in plain English. If we can help, we say how, with a flat-rate written proposal. If you do not need us, we say that too.</p></article>
      </div>
      <div class="steps-cta"><a class="btn btn-primary lp-cta" href="#book">Get My Free Visibility Audit</a></div>
    </div>
  </section>

  <section class="band-sage">
    <div class="section-wrap">
    <div class="section-head">
      <div><div class="section-label">Who prepares it</div><h2>Real people, therapy practices only.</h2></div>
      <p>No sales team and no call center. Your audit is prepared by the people who run Moonraker and work with therapy practices every day.</p>
    </div>
    <div class="people-grid">
      <article class="person-card">
        <img class="person-photo" src="/assets/team/chris-morin.avif" alt="Chris Morin, Founder of Moonraker" width="1080" height="1439" loading="lazy" decoding="async">
        <div>
          <h3>Chris Morin</h3>
          <div class="person-role">Founder. Builds your strategy with Scott.</div>
          <p>Before marketing, Chris was a massage therapist for over 15 years. That work showed him how many gifted practitioners struggle to reach the clients who need them most. Moonraker exists to close that gap: real visibility for therapists, so they can build the practice of their dreams.</p>
        </div>
      </article>
      <article class="person-card">
        <img class="person-photo" src="/assets/team/scott-pope-wide.avif" alt="Scott Pope, Director of Growth and Operations at Moonraker" width="1500" height="1780" loading="lazy" decoding="async">
        <div>
          <h3>Scott Pope</h3>
          <div class="person-role">Director of Growth and Operations. Prepares your audit.</div>
          <p>Scott works at the intersection of SEO strategy, AI adoption, and compliance, the three areas that overwhelm most practitioners but determine whether a practice grows. He writes our weekly newsletter translating Google and AI changes into plain English for busy clinicians.</p>
        </div>
      </article>
    </div>
    </div>
  </section>

  <section class="band-paper">
    <div class="section-wrap">
    <div class="section-head">
      <div><div class="section-label">If we work together</div><h2>Three steps. Start where you are.</h2></div>
      <p>Every engagement is a flat-rate project quoted in writing. You pick the level that fits, and each step includes the one before it.</p>
    </div>
    <div class="ladder-stack">
      <div class="ladder-preview"><div class="ladder-num">1</div><div><h3>Visibility Audit + Fixes</h3><p>Find every gap, then fix what we can on your current website. Nothing moves.</p></div></div>
      <div class="ladder-preview"><div class="ladder-num">2</div><div><h3>Platform Upgrade</h3><p>Everything above, plus your site moved page for page onto our fast, secure Cloudflare foundation.</p></div></div>
      <div class="ladder-preview"><div class="ladder-num">3</div><div><h3>Full Practice Rebuild</h3><p>Everything above, plus a full redesign and the conversion-focused pages your practice is missing.</p></div></div>
    </div>
    </div>
  </section>

  <section class="band-sage">
    <div class="section-wrap faq-wrap">
    <div class="section-label">Quick answers</div>
    <h2>Before you request yours.</h2>
    <div class="faq-list">
      <details open name="lp-faq"><summary>Is the audit really free?</summary><p>Yes. The audit costs nothing and comes with no obligation. If we can help, you get a flat-rate written proposal alongside it. No hourly billing, no long-term contracts.</p></details>
      <details name="lp-faq"><summary>What do you actually check?</summary><p>How your practice shows up on Google Search, Google Maps, and AI tools like ChatGPT and Gemini: your listings, your pages, your reviews, and whether the clients searching for your services can find you at all.</p></details>
      <details name="lp-faq"><summary>Do I have to get on a call?</summary><p>No. The audit arrives by email and stands on its own. If you want to talk it through afterward, you can book a free strategy call, but plenty of practices just take the list and run with it.</p></details>
      <details name="lp-faq"><summary>Who do you work with?</summary><p>Therapy practices only: solo practitioners, group practices, and intensives or retreats. That focus is why the audit is fast and the recommendations are specific.</p></details>
      <details name="lp-faq"><summary>What does it cost if we go ahead?</summary><p>Every engagement is a flat-rate project quoted in writing, never hourly and never a retainer you have to escape. Our smallest starting step is scoped to the gaps we actually find, so you see the number before you commit to anything.</p></details>
      <details name="lp-faq"><summary>How much of my time will this take?</summary><p>About two minutes, to fill in the form below. Scott does the rest and emails you the result, usually within two business days.</p></details>
    </div>
    </div>
  </section>

  <LpAuditForm
    heading="See where your practice stands."
    description="Scott personally checks how your practice shows up across Google, Maps, and AI tools, then emails you what he found and what to fix first."
  />
</main>
</BaseLayout>

<style>
.lp-hero { position: relative; overflow: hidden; background: linear-gradient(158deg, var(--color-navy) 0%, var(--color-navy-deep) 100%); color: var(--color-on-navy-dim); padding: clamp(3.75rem, 6.5vw, 5rem) 2rem; }
.lp-hero::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    linear-gradient(to right, oklch(0.945 0.018 166 / 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(0.945 0.018 166 / 0.05) 1px, transparent 1px);
  background-size: 62px 62px;
  -webkit-mask-image: radial-gradient(80% 120% at 50% 0%, #000 0%, transparent 72%);
  mask-image: radial-gradient(80% 120% at 50% 0%, #000 0%, transparent 72%);
  pointer-events: none;
}
.lp-hero .hero-inner { position: relative; z-index: 1; }
.hero-inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 6vw, 4rem); align-items: center; }
.lp-hero h1 { color: var(--color-on-navy); font-size: clamp(2.4rem, 4.6vw, 4.2rem); line-height: 1.05; letter-spacing: -.02em; margin-bottom: 1.1rem; }
.lp-hero p { color: var(--color-on-navy-dim); font-size: 1.08rem; line-height: 1.75; }
.hero-cta { margin-top: 1.6rem; }
.lp-cta { font-size: 1.02rem; padding: .9rem 1.6rem; }
.hero-video { display: grid; gap: .6rem; }
.video-caption { font-size: .84rem; color: var(--color-on-navy-dim); text-align: center; }
.section-wrap { max-width: 1120px; margin: 0 auto; padding: clamp(3.5rem, 6vw, 5rem) 2rem; }
.section-label { color: var(--color-primary-text); font-weight: 800; font-size: .74rem; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .7rem; }
.section-head { display: grid; grid-template-columns: .9fr 1.1fr; gap: 2rem; margin-bottom: 2rem; align-items: end; }
.section-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); }
.section-head p { color: var(--color-muted); line-height: 1.75; }
.reviews-head { margin-bottom: 1.75rem; }
.reviews-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); }
/* Flex rather than grid so the trailing row of 8 cards CENTERS instead of
   hanging left under column one, which reads like a mistake. */
.reviews-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
.review-card { flex: 1 1 300px; max-width: 360px; background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--r-lg); padding: 1.4rem; display: grid; gap: .8rem; align-content: start; }
.review-stars { color: var(--color-primary); letter-spacing: .1em; }
.review-quote { color: var(--color-body); line-height: 1.65; font-size: .94rem; }
.review-author { display: grid; grid-template-columns: 40px 1fr; gap: .7rem; align-items: center; }
.review-avatar { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--color-navy); color: var(--color-primary); font-family: 'Outfit', sans-serif; font-weight: 800; font-size: .85rem; }
.review-name { font-weight: 600; color: var(--color-heading); font-size: .92rem; }
.review-meta { font-size: .8rem; color: var(--color-muted); }
.steps-band { background: var(--band-paper); }
.steps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
.step-card { background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--r-lg); padding: 1.4rem; }
.step-num { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--color-navy); color: var(--color-primary); font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.15rem; margin-bottom: .9rem; }
.step-card h3 { margin-bottom: .45rem; }
.step-card p { color: var(--color-muted); font-size: .92rem; line-height: 1.65; }
.steps-cta { margin-top: 2rem; text-align: center; }
.ladder-stack { border: 1px solid var(--color-hairline); border-radius: var(--r-lg); overflow: hidden; background: var(--color-surface); }
.ladder-preview { display: grid; grid-template-columns: 64px 1fr; gap: 1rem; padding: 1.1rem; border-bottom: 1px solid var(--color-border); }
.ladder-preview:last-child { border-bottom: 0; }
.ladder-num { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: var(--color-navy); color: var(--color-primary); font-family: 'Outfit', sans-serif; font-size: 1.35rem; font-weight: 800; }
.ladder-preview h3 { margin-bottom: .25rem; }
.ladder-preview p { font-size: .88rem; line-height: 1.55; color: var(--color-muted); }
.partners-band { background: var(--band-sage); }
.partners-band .section-wrap { padding-top: clamp(2.5rem, 4vw, 3.5rem); padding-bottom: clamp(2.5rem, 4vw, 3.5rem); }
/* text-align carries !important because globals.css forces every h1-h3
   to text-align: left !important below 768px (the site-wide mobile
   heading convention). This heading is a centered band over centered
   logos on every viewport, so it opts out. */
.partners-heading { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: clamp(1.8rem, 3vw, 2.6rem); letter-spacing: -.02em; text-align: center !important; text-wrap: balance; max-width: 30ch; margin: 0 auto 2.25rem; line-height: 1.12; }
.partner-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(1.5rem, 4vw, 3rem); }
.partner-logo { height: 76px; width: auto; max-width: 210px; object-fit: contain; opacity: .85; }
.people-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem; }
.person-card { background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--r-lg); overflow: hidden; display: grid; grid-template-columns: clamp(190px, 24%, 250px) 1fr; align-items: stretch; }
.person-photo { width: 100%; height: 100%; min-height: 320px; border-radius: 0; object-fit: cover; object-position: center 18%; }
.person-card > div { padding: 1.75rem; align-self: center; }
.person-card h3 { margin-bottom: .2rem; }
.person-role { font-size: .82rem; font-weight: 600; color: var(--color-primary-text); margin-bottom: .6rem; }
.person-card p { color: var(--color-muted); font-size: .9rem; line-height: 1.65; }
.faq-wrap h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); margin-bottom: 1.5rem; }
.faq-list { display: grid; gap: .8rem; }
details { background: var(--color-surface); border: 1px solid var(--color-hairline); border-radius: var(--r-lg); padding: 1.1rem 1.25rem; }
summary { cursor: pointer; font-family: 'Outfit', sans-serif; color: var(--color-heading); font-weight: 800; }
details p { color: var(--color-muted); font-size: .92rem; line-height: 1.7; margin-top: .8rem; }
@media (max-width: 860px) {
  .hero-inner, .section-head { grid-template-columns: 1fr; }
  .partner-logo { height: 56px; max-width: 44%; }
  .person-card { grid-template-columns: 1fr; }
  .person-photo { min-height: 0; aspect-ratio: 4 / 3; object-position: center 15%; }
  .person-card > div { padding: 1.5rem; }
}
</style>

